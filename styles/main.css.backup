/* Global Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary-color: #d4af37;
    --secondary-color: #1a1a2e;
    --accent-color: #c41e3a;
    --bg-dark: #0f0f1e;
    --bg-card: #1a1a2e;
    --text-light: #ffffff;
    --text-muted: #a0a0b0;
    --success: #2ecc71;
    --danger: #e74c3c;
    --warning: #f39c12;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, var(--bg-dark) 0%, #16213e 100%);
    color: var(--text-light);
    min-height: 100vh;
    line-height: 1.6;
}

.container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header */
.main-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #2d2d44 100%);
    padding: 20px 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    border-bottom: 2px solid var(--primary-color);
}

.main-header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo h1 {
    font-size: 2.5rem;
    color: var(--primary-color);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    margin-bottom: 5px;
}

.tagline {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
}

.user-balance {
    display: flex;
    align-items: center;
    gap: 15px;
}

.balance-display {
    background: rgba(212, 175, 55, 0.1);
    padding: 12px 20px;
    border-radius: 8px;
    border: 2px solid var(--primary-color);
}

.balance-label {
    color: var(--text-muted);
    margin-right: 10px;
}

.balance-amount {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary-color);
}

.currency {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-left: 5px;
}

.btn-deposit, .btn-withdraw {
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.3s;
}

.btn-deposit {
    background: var(--success);
    color: white;
}

.btn-deposit:hover {
    background: #27ae60;
    transform: translateY(-2px);
}

.btn-withdraw {
    background: var(--danger);
    color: white;
}

.btn-withdraw:hover {
    background: #c0392b;
    transform: translateY(-2px);
}

/* Navigation */
.main-nav {
    background: var(--bg-card);
    padding: 15px 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.nav-menu {
    list-style: none;
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
}

.nav-btn {
    padding: 10px 25px;
    background: transparent;
    border: 2px solid rgba(212, 175, 55, 0.3);
    color: var(--text-light);
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 1rem;
}

.nav-btn:hover {
    border-color: var(--primary-color);
    background: rgba(212, 175, 55, 0.1);
}

.nav-btn.active {
    background: var(--primary-color);
    color: var(--bg-dark);
    border-color: var(--primary-color);
}

.nav-btn-special {
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

.nav-btn-special:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
}

/* Main Content */
.main-content {
    padding: 40px 0;
    min-height: calc(100vh - 300px);
}

/* Game Grid */
.game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 25px;
    margin-top: 20px;
}

.game-card {
    background: var(--bg-card);
    border-radius: 15px;
    padding: 30px;
    text-align: center;
    transition: all 0.3s;
    border: 2px solid rgba(212, 175, 55, 0.2);
    cursor: pointer;
}

.game-card:hover {
    transform: translateY(-12px) scale(1.02);
    border-color: var(--primary-color);
    box-shadow: 
        0 15px 40px rgba(212, 175, 55, 0.5),
        0 0 30px rgba(212, 175, 55, 0.3),
        inset 0 1px 5px rgba(212, 175, 55, 0.2);
    background: linear-gradient(135deg, rgba(26, 26, 46, 1), rgba(45, 45, 68, 1));
}

.game-card:hover .game-icon {
    transform: scale(1.2) rotateY(180deg);
    filter: drop-shadow(0 0 10px var(--primary-color));
}

.game-icon {
    font-size: 4rem;
    margin-bottom: 15px;
    transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    display: inline-block;
}

.game-card h3 {
    color: var(--primary-color);
    margin-bottom: 10px;
    font-size: 1.5rem;
}

.game-card p {
    color: var(--text-muted);
    margin-bottom: 20px;
}

.btn-play {
    padding: 12px 30px;
    background: linear-gradient(135deg, var(--primary-color) 0%, #b8941f 100%);
    color: var(--bg-dark);
    border: none;
    border-radius: 25px;
    cursor: pointer;
    font-weight: bold;
    font-size: 1rem;
    transition: all 0.3s;
}

.btn-play:hover {
    transform: scale(1.05);
    box-shadow: 0 5px 15px rgba(212, 175, 55, 0.4);
}

/* Game Container */
.game-container {
    background: var(--bg-card);
    border-radius: 15px;
    padding: 30px;
    border: 2px solid var(--primary-color);
}

.game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(212, 175, 55, 0.2);
}

.game-header h2 {
    color: var(--primary-color);
    font-size: 2rem;
}

.btn-back {
    padding: 10px 20px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border: 2px solid var(--primary-color);
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-back:hover {
    background: var(--primary-color);
    color: var(--bg-dark);
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
}

.modal-content {
    background: var(--bg-card);
    margin: 10% auto;
    padding: 30px;
    border: 2px solid var(--primary-color);
    border-radius: 15px;
    width: 90%;
    max-width: 500px;
    position: relative;
}

.close {
    color: var(--text-muted);
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    line-height: 20px;
}

.close:hover {
    color: var(--primary-color);
}

.wallet-info {
    margin-top: 20px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: var(--text-muted);
}

.form-group input {
    width: 100%;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(212, 175, 55, 0.3);
    border-radius: 5px;
    color: var(--text-light);
    font-size: 1rem;
}

.form-group input:focus {
    outline: none;
    border-color: var(--primary-color);
}

.btn-confirm {
    width: 100%;
    padding: 15px;
    background: var(--primary-color);
    color: var(--bg-dark);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    font-size: 1.1rem;
    transition: all 0.3s;
}

.btn-confirm:hover {
    background: #b8941f;
    transform: translateY(-2px);
}

/* Footer */
.main-footer {
    background: var(--bg-card);
    padding: 30px 0;
    text-align: center;
    border-top: 2px solid var(--primary-color);
    margin-top: 50px;
}

.main-footer p {
    color: var(--text-muted);
    margin: 5px 0;
}

.disclaimer {
    font-size: 0.9rem;
    color: var(--primary-color);
}

/* Game-Specific Styles */
.poker-table {
    background: 
        radial-gradient(ellipse at center, #0d7d0d 0%, #0a5f0a 50%, #084808 100%);
    border: 12px solid #6d4c28;
    border-radius: 200px / 100px;
    padding: 40px;
    margin: 20px auto;
    max-width: 900px;
    position: relative;
    box-shadow: 
        0 0 50px rgba(0, 0, 0, 0.7),
        inset 0 0 100px rgba(0, 0, 0, 0.3),
        inset 0 2px 40px rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
}

.poker-table::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 10px,
        rgba(255, 255, 255, 0.02) 10px,
        rgba(255, 255, 255, 0.02) 20px
    );
    pointer-events: none;
}

.player-position {
    position: absolute;
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.95), rgba(45, 45, 68, 0.95));
    padding: 15px;
    border-radius: 12px;
    border: 3px solid var(--primary-color);
    min-width: 160px;
    box-shadow: 
        0 8px 20px rgba(0, 0, 0, 0.6),
        inset 0 1px 3px rgba(212, 175, 55, 0.3);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
}

.player-position:hover {
    transform: scale(1.05);
    border-color: #ffd700;
    box-shadow: 0 12px 30px rgba(212, 175, 55, 0.4);
}

.community-cards {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 20px 0;
    min-height: 120px;
}

.community-cards .card {
    animation: cardReveal 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes cardReveal {
    0% {
        transform: rotateY(180deg) scale(0.5);
        opacity: 0;
    }
    100% {
        transform: rotateY(0deg) scale(1);
        opacity: 1;
    }
}

.card {
    width: 70px;
    height: 100px;
    background: linear-gradient(145deg, #ffffff, #f5f5f5);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    font-weight: bold;
    box-shadow: 
        0 8px 16px rgba(0, 0, 0, 0.4),
        inset 0 1px 2px rgba(255, 255, 255, 0.8),
        inset 0 -1px 2px rgba(0, 0, 0, 0.1);
    position: relative;
    border: 2px solid #ddd;
    transform-style: preserve-3d;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
}

.card:hover {
    transform: translateY(-5px) rotateX(10deg);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
}

.card.back {
    background: linear-gradient(135deg, #1a1a2e 0%, #d4af37 50%, #1a1a2e 100%);
    background-size: 200% 200%;
    animation: cardShimmer 3s ease infinite;
}

@keyframes cardShimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

.card.red {
    color: #d32f2f;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.card.black {
    color: #1a1a1a;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
}

.betting-controls {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-top: 30px;
    flex-wrap: wrap;
}

.bet-btn {
    padding: 14px 28px;
    border: 3px solid var(--primary-color);
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(212, 175, 55, 0.05));
    color: var(--text-light);
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.bet-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.bet-btn:hover::before {
    width: 300px;
    height: 300px;
}

.bet-btn:hover:not(:disabled) {
    background: linear-gradient(135deg, var(--primary-color), #b8941f);
    color: var(--bg-dark);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.4);
    border-color: #ffd700;
}

.bet-btn:active:not(:disabled) {
    transform: translateY(-1px);
}

.bet-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background: rgba(100, 100, 100, 0.2);
    border-color: #666;
}

.pot-display {
    text-align: center;
    font-size: 1.8rem;
    color: var(--primary-color);
    margin: 20px 0;
    font-weight: bold;
    text-shadow: 
        0 0 10px rgba(212, 175, 55, 0.8),
        0 0 20px rgba(212, 175, 55, 0.5),
        0 0 30px rgba(212, 175, 55, 0.3);
    animation: potGlow 2s ease-in-out infinite;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), transparent);
    padding: 15px;
    border-radius: 10px;
    border: 2px solid rgba(212, 175, 55, 0.3);
}

@keyframes potGlow {
    0%, 100% { 
        text-shadow: 
            0 0 10px rgba(212, 175, 55, 0.8),
            0 0 20px rgba(212, 175, 55, 0.5),
            0 0 30px rgba(212, 175, 55, 0.3);
    }
    50% { 
        text-shadow: 
            0 0 15px rgba(212, 175, 55, 1),
            0 0 30px rgba(212, 175, 55, 0.7),
            0 0 45px rgba(212, 175, 55, 0.5);
    }
}

/* Board Games */
.board-container {
    max-width: 600px;
    margin: 0 auto;
}

.chess-board, .checkers-board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0;
    max-width: 600px;
    margin: 20px auto;
    border: 6px solid var(--primary-color);
    box-shadow: 
        0 10px 40px rgba(0, 0, 0, 0.6),
        inset 0 2px 10px rgba(212, 175, 55, 0.2);
    border-radius: 4px;
}

.board-square {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}

.board-square::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0, 0, 0, 0.1) 100%);
    opacity: 0;
    transition: opacity 0.3s;
}

.board-square.light {
    background: linear-gradient(135deg, #f5e6d3 0%, #f0d9b5 100%);
}

.board-square.dark {
    background: linear-gradient(135deg, #c09060 0%, #b58863 100%);
}

.board-square:hover::before {
    opacity: 1;
}

.board-square:hover {
    box-shadow: inset 0 0 20px rgba(212, 175, 55, 0.6);
    transform: scale(0.95);
}

.board-square.selected {
    background: linear-gradient(135deg, #f39c12, #e67e22) !important;
    box-shadow: 
        inset 0 0 20px rgba(0, 0, 0, 0.3),
        0 0 20px rgba(243, 156, 18, 0.8);
    animation: selectedPulse 1s ease-in-out infinite;
}

@keyframes selectedPulse {
    0%, 100% { box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.3), 0 0 20px rgba(243, 156, 18, 0.8); }
    50% { box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.4), 0 0 30px rgba(243, 156, 18, 1); }
}

.board-square.valid-move {
    background: linear-gradient(135deg, #2ecc71, #27ae60) !important;
    animation: validMovePulse 1s ease-in-out infinite;
}

@keyframes validMovePulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
}

@keyframes slideInRight {
    from {
        transform: translateX(400px);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@keyframes slideOutRight {
    from {
        transform: translateX(0);
        opacity: 1;
    }
    to {
        transform: translateX(400px);
        opacity: 0;
    }
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(231, 76, 60, 0.7);
    }
    50% {
        transform: scale(1.1);
        box-shadow: 0 0 0 10px rgba(231, 76, 60, 0);
    }
}

/* Lottery & Quick Games */
.scratch-card {
    width: 400px;
    height: 300px;
    margin: 20px auto;
    position: relative;
    background: 
        radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.3), transparent 50%),
        linear-gradient(135deg, #ffd700 0%, #ffed4e 50%, #ffd700 100%);
    border: 5px solid var(--primary-color);
    border-radius: 15px;
    cursor: crosshair;
    box-shadow: 
        0 10px 30px rgba(0, 0, 0, 0.5),
        inset 0 2px 10px rgba(255, 255, 255, 0.3);
}

.scratch-surface {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background: linear-gradient(135deg, #999 0%, #666 100%);
    border-radius: 15px;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.5);
}

.lottery-numbers {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin: 20px 0;
    flex-wrap: wrap;
}

.lottery-ball {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: 
        radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.8), transparent 50%),
        radial-gradient(circle at center, #ffd700 0%, var(--primary-color) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: bold;
    color: var(--bg-dark);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 3px solid rgba(0, 0, 0, 0.3);
    box-shadow: 
        0 6px 15px rgba(0, 0, 0, 0.4),
        inset 0 -3px 8px rgba(0, 0, 0, 0.3),
        inset 0 3px 8px rgba(255, 255, 255, 0.6);
    position: relative;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
}

.lottery-ball::after {
    content: '';
    position: absolute;
    top: 15%;
    left: 20%;
    width: 30%;
    height: 30%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.6), transparent);
    border-radius: 50%;
    filter: blur(3px);
}

.lottery-ball:hover {
    transform: scale(1.15) translateY(-3px);
    box-shadow: 
        0 10px 25px rgba(212, 175, 55, 0.6),
        inset 0 -3px 8px rgba(0, 0, 0, 0.3),
        inset 0 3px 8px rgba(255, 255, 255, 0.7);
}

.lottery-ball.selected {
    background: 
        radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.8), transparent 50%),
        radial-gradient(circle at center, #2ecc71 0%, #27ae60 100%);
    transform: scale(1.2) translateY(-5px);
    animation: ballSelected 0.5s ease;
    box-shadow: 
        0 12px 30px rgba(46, 204, 113, 0.7),
        inset 0 -3px 8px rgba(0, 0, 0, 0.3),
        inset 0 3px 8px rgba(255, 255, 255, 0.7);
}

@keyframes ballSelected {
    0%, 100% { transform: scale(1.2) translateY(-5px); }
    50% { transform: scale(1.3) translateY(-8px); }
}

.coin-flip-container {
    text-align: center;
}

.coin {
    width: 200px;
    height: 200px;
    margin: 30px auto;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 2s;
    perspective: 1000px;
}

.coin.flipping {
    animation: flip 2s cubic-bezier(0.36, 0, 0.64, 1);
}

@keyframes flip {
    0% { 
        transform: rotateY(0deg) rotateX(0deg) translateY(0px);
    }
    25% {
        transform: rotateY(450deg) rotateX(180deg) translateY(-50px);
    }
    50% {
        transform: rotateY(900deg) rotateX(360deg) translateY(0px);
    }
    75% {
        transform: rotateY(1350deg) rotateX(540deg) translateY(-30px);
    }
    100% { 
        transform: rotateY(1800deg) rotateX(720deg) translateY(0px);
    }
}

.coin-face {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: 
        radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.3), transparent 60%),
        radial-gradient(circle at center, #ffd700 0%, var(--primary-color) 50%, #8b7500 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    border: 8px solid #6d5400;
    box-shadow: 
        0 15px 40px rgba(0, 0, 0, 0.6),
        inset 0 -8px 20px rgba(0, 0, 0, 0.4),
        inset 0 8px 20px rgba(255, 255, 255, 0.3);
    position: relative;
}

.coin-face::before {
    content: '';
    position: absolute;
    top: 10%;
    left: 15%;
    width: 40%;
    height: 40%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.4), transparent 70%);
    border-radius: 50%;
    filter: blur(10px);
}

.dice-container {
    text-align: center;
    perspective: 1000px;
}

.dice {
    width: 150px;
    height: 150px;
    margin: 30px auto;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.1s;
}

.dice-face {
    width: 150px;
    height: 150px;
    background: linear-gradient(145deg, #ffffff, #e6e6e6);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--bg-dark);
    font-weight: bold;
    box-shadow: 
        0 10px 30px rgba(0, 0, 0, 0.3),
        inset 0 2px 10px rgba(255, 255, 255, 0.8),
        inset 0 -2px 10px rgba(0, 0, 0, 0.2);
    border: 3px solid #ccc;
}

.dice.rolling {
    animation: diceRoll 2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes diceRoll {
    0% { 
        transform: rotate3d(0, 0, 0, 0deg) translateY(0px);
    }
    10% {
        transform: rotate3d(1, 1, 0, 180deg) translateY(-50px);
    }
    20% {
        transform: rotate3d(1, -1, 0, 360deg) translateY(0px);
    }
    30% {
        transform: rotate3d(-1, 1, 0, 540deg) translateY(-40px);
    }
    40% {
        transform: rotate3d(1, 0, 1, 720deg) translateY(0px);
    }
    50% {
        transform: rotate3d(0, 1, 1, 900deg) translateY(-30px);
    }
    60% {
        transform: rotate3d(1, 1, 1, 1080deg) translateY(0px);
    }
    70% {
        transform: rotate3d(-1, 0, 1, 1260deg) translateY(-20px);
    }
    80% {
        transform: rotate3d(1, -1, 1, 1440deg) translateY(0px);
    }
    90% {
        transform: rotate3d(0, 1, 0, 1620deg) translateY(-10px);
    }
    100% { 
        transform: rotate3d(0, 0, 0, 1800deg) translateY(0px);
    }
}

.game-info {
    background: rgba(212, 175, 55, 0.1);
    padding: 20px;
    border-radius: 10px;
    margin: 20px 0;
    border: 2px solid rgba(212, 175, 55, 0.3);
}

.game-info h3 {
    color: var(--primary-color);
    margin-bottom: 10px;
}

.game-message {
    text-align: center;
    font-size: 1.3rem;
    color: var(--primary-color);
    margin: 20px 0;
    padding: 15px;
    background: rgba(212, 175, 55, 0.1);
    border-radius: 10px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .main-header .container {
        flex-direction: column;
        gap: 20px;
    }

    .game-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }

    .logo h1 {
        font-size: 2rem;
    }

    .balance-amount {
        font-size: 1.2rem;
    }

    .chess-board, .checkers-board {
        max-width: 400px;
    }

    .board-square {
        font-size: 2rem;
    }
}
